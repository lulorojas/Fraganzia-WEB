rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un usuario es admin si existe su documento en /admins/{uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Mapea un uid autenticado al socioId correspondiente (docs socios/luciano,
    // socios/benja), usando `exists()` primero para no fallar si alguno de los
    // dos documentos todavía no fue dado de alta.
    function socioIdDe(uid) {
      return exists(/databases/$(database)/documents/socios/luciano)
          && get(/databases/$(database)/documents/socios/luciano).data.authUid == uid
        ? 'luciano'
        : (exists(/databases/$(database)/documents/socios/benja)
            && get(/databases/$(database)/documents/socios/benja).data.authUid == uid
          ? 'benja'
          : null);
    }

    // Catálogo: lectura pública; escritura solo admin.
    match /perfumes/{perfumeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promociones: lectura pública; escritura solo admin.
    match /promociones/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config: lectura pública (el cliente necesita whatsappNumero y el
    // fallback dolarBlueManual); escritura solo admin.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un contador público solo puede quedar igual o subir de a 1 por escritura
    // (el cliente usa `increment(1)`). Si el campo no existía, parte de 0.
    function contadorValido(campo) {
      let antes = resource == null ? 0 : resource.data.get(campo, 0);
      let despues = request.resource.data.get(campo, 0);
      return despues is int && (despues == antes || despues == antes + 1);
    }

    // Pedidos: el cliente PUEDE crear su pedido; solo admin lee/edita/borra.
    // Sin backend, el precio lo calcula el navegador: la regla no puede
    // verificarlo, pero sí limita la forma, los tipos y los tamaños para que no
    // se puedan inyectar campos extra ni documentos gigantes. El admin revisa
    // el pedido al confirmarlo por WhatsApp.
    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.keys().hasOnly([
            'items', 'metodoPago', 'dolarBlueUsado', 'subtotalARS', 'descuentoARS',
            'totalARS', 'clienteNombre', 'clienteEmail', 'estado', 'creadoEn'])
        && request.resource.data.keys().hasAll([
            'items', 'metodoPago', 'dolarBlueUsado', 'subtotalARS', 'descuentoARS',
            'totalARS', 'clienteNombre', 'estado', 'creadoEn'])
        && request.resource.data.estado == 'confirmado'
        && request.resource.data.metodoPago in ['Transferencia', 'Efectivo']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 30
        && request.resource.data.clienteNombre is string
        && request.resource.data.clienteNombre.size() >= 1
        && request.resource.data.clienteNombre.size() <= 100
        && (!('clienteEmail' in request.resource.data)
            || (request.resource.data.clienteEmail is string
                && request.resource.data.clienteEmail.size() <= 120))
        && request.resource.data.dolarBlueUsado is number
        && request.resource.data.dolarBlueUsado > 0
        && request.resource.data.subtotalARS is number
        && request.resource.data.subtotalARS > 0
        && request.resource.data.descuentoARS is number
        && request.resource.data.totalARS is number
        && request.resource.data.totalARS > 0
        && request.resource.data.totalARS < 1000000000
        && request.resource.data.creadoEn == request.time;
      // Seguimiento: quien tiene el link (/pedido/<id>) puede leer ESE pedido.
      // El id lo genera Firestore (20 caracteres al azar): no se puede adivinar,
      // y listar pedidos sigue siendo solo para admin.
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Estadísticas: sin Cloud Functions, el cliente incrementa contadores
    // desde el navegador. Lectura solo admin (dashboard). La escritura pública
    // se limita a los campos permitidos, al id del perfume del documento y a
    // subir cada contador de a 1, para que nadie pueda inflarlos de golpe.
    match /estadisticas/{perfumeId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys()
          .hasOnly(['perfumeId', 'vistas', 'agregadosCarrito', 'favoritos', 'updatedAt'])
        && request.resource.data.perfumeId == perfumeId
        && contadorValido('vistas')
        && contadorValido('agregadosCarrito')
        && contadorValido('favoritos')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Términos buscados en el catálogo. Mismo trade-off consciente que
    // `estadisticas` (nota crítica #7 de la constitución): sin backend, el
    // contador lo incrementa el navegador y la regla limita campos, largo del
    // término y cuánto puede subir cada contador. Lectura solo admin.
    match /busquedas/{termino} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys()
          .hasOnly(['termino', 'conteo', 'sinResultados', 'updatedAt'])
        && termino.size() >= 3
        && termino.size() <= 80
        && request.resource.data.termino == termino
        && contadorValido('conteo')
        && contadorValido('sinResultados')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Visitas anónimas (una por sesión). El navegador crea el documento con su
    // forma fija y tamaños acotados; no se puede editar. Lectura solo admin.
    match /visitas/{visitaId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys()
          .hasOnly(['ruta', 'fuente', 'dispositivo', 'navegador', 'so', 'idioma', 'createdAt'])
        && request.resource.data.ruta is string && request.resource.data.ruta.size() <= 120
        && request.resource.data.fuente is string && request.resource.data.fuente.size() <= 60
        && request.resource.data.dispositivo is string && request.resource.data.dispositivo.size() <= 20
        && request.resource.data.navegador is string && request.resource.data.navegador.size() <= 20
        && request.resource.data.so is string && request.resource.data.so.size() <= 20
        && request.resource.data.idioma is string && request.resource.data.idioma.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Admins: solo admins leen; alta/baja se hace manualmente (consola).
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Panel financiero interno de socios (privado, solo isAdmin) ──────────

    // Socios: mapeo uid admin -> socio (nombre, authUid). Solo lectura/escritura admin.
    match /socios/{socioId} {
      allow read, write: if isAdmin();
    }

    // Ventas directas de perfumes por los socios (distinto de `pedidos`, que son
    // las compras online del catálogo público).
    match /ventasSocios/{id} {
      allow read, write: if isAdmin();
    }

    // Ventas de decants.
    match /ventasDecants/{id} {
      allow read, write: if isAdmin();
    }

    // Compras a proveedores.
    match /compras/{id} {
      allow read, write: if isAdmin();
    }

    // Gastos compartidos del negocio.
    match /gastos/{id} {
      allow read, write: if isAdmin();
    }

    // Aportes/retiros propios de cada socio: privados — cada socio solo puede
    // leer, crear, editar o anular sus propios movimientos, nunca los del otro.
    match /movimientosPersonales/{id} {
      allow read: if isAdmin() && resource.data.socioId == socioIdDe(request.auth.uid);
      allow create: if isAdmin() && request.resource.data.socioId == socioIdDe(request.auth.uid);
      allow update, delete: if isAdmin() && resource.data.socioId == socioIdDe(request.auth.uid);
    }

    // Transferencias de dinero entre socios (solo constancia contable).
    match /transferenciasSocios/{id} {
      allow read, write: if isAdmin();
    }

    // Ajustes manuales de stock: mercadería que no vino de una compra
    // registrada, o bajas por pérdida/rotura.
    match /ajustesStock/{id} {
      allow read, write: if isAdmin();
    }

    // Cambio de efectivo a Mercado Pago o al revés, dentro del bolsillo de un
    // mismo socio.
    match /cambiosMetodo/{id} {
      allow read, write: if isAdmin();
    }

    // Auditoría de creación/edición/anulación de movimientos de este módulo.
    // Las entradas de movimientos personales llevan `socioPrivado` y solo las
    // lee su dueño: si no, el otro socio vería por acá el detalle que la regla
    // de movimientosPersonales le oculta. `socioPrivado == null` = compartida.
    match /auditoria/{id} {
      allow read: if isAdmin()
        && (resource.data.socioPrivado == null
            || resource.data.socioPrivado == socioIdDe(request.auth.uid));
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Log del bot de precios del proveedor (tools/bot-proveedor.mjs): lo
    // escribe el script con la cuenta de servicio (sin pasar por estas
    // reglas), el admin solo lo lee para ver el resumen de cada corrida.
    match /botProveedorLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
